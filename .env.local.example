# Supabase — The Twin App
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key

# Anthropic — Coach IA + traduction recettes
